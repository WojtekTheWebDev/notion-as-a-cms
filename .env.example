NOTION_SECRET=
NOTION_DATABASE_ID=
NOTION_IMAGE_HOSTNAME=prod-files-secure.s3.us-west-2.amazonaws.com

# Style theme. One of: notion (default), editorial. Falls back to notion when unset/unknown.
SITE_THEME=notion
# Accent color (hex) used by themes that support it (e.g. editorial link underlines).
# Falls back to #c9a66b when unset/invalid.
SITE_ACCENT=#c9a66b
